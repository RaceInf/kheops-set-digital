# Configuration du serveur
NODE_ENV=development
PORT=3001
HTTPS_PORT=3443

# Configuration de la base de données
DB_PATH=./data/kheops.db

# Sécurité
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=2h
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Frontend URL (pour CORS)
FRONTEND_URL=https://localhost:8081

# Certificats SSL (optionnel)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Email (pour les notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@kheops-set-digital.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Logs
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Sécurité avancée
SECURITY_HEADERS_ENABLED=true
CORS_CREDENTIALS=true
SESSION_SECRET=your-session-secret-here

# API Keys (optionnel)
UNSPLASH_API_KEY=your-unsplash-api-key
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# Monitoring
ENABLE_MONITORING=true
METRICS_PORT=9090

# Base de données
DB_ENCRYPTION_KEY=your-super-secret-encryption-key-32-chars

# 2FA Configuration
TOTP_ISSUER=KHEOPS SET DIGITAL
TOTP_LABEL=Admin Panel

# SSL/TLS Configuration
SSL_CA_PATH=./ssl/ca_bundle.crt

# Logging
AUDIT_LOG_PATH=./logs/audit.log

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# SSL/TLS Configuration
SSL_KEY_PATH=./ssl/private.key
SSL_CERT_PATH=./ssl/certificate.crt
SSL_CA_PATH=./ssl/ca_bundle.crt

# Logging
LOG_FILE_PATH=./logs/app.log
AUDIT_LOG_PATH=./logs/audit.log

# Security Headers
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Session Configuration
SESSION_MAX_AGE=7200000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_PATH=./backups

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true 